{#
 # Media Chrome look-alike controls for Polymedia's Video.js engine.
 #
 # Passing `children` swaps the packaged skin for <media-container> with these
 # controls, and media-chrome.css styles them like Media Chrome's control bar:
 #
 #   {{ craft.polymedia.player(media, {
 #       class: 'media-chrome',
 #       children: include('_polymedia/media-chrome-controls.twig'),
 #   }) }}
 #
 # The icons are Media Chrome's (MIT licence, github.com/muxinc/media-chrome).
 #}
<media-controls class="mc-controls">
    <div class="mc-bar">
        <media-play-button class="mc-button">
            <svg class="mc-icon mc-play" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 21 15-9L6 3v18Z"/></svg>
            <svg class="mc-icon mc-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 20h4V4H6v16Zm8-16v16h4V4h-4Z"/></svg>
        </media-play-button>
        <media-seek-button class="mc-button" seconds="-30">
            <svg class="mc-icon" viewBox="0 0 20 24" aria-hidden="true"><text class="mc-seek-label" x="2.18" y="19.87">30</text><path d="M10 6V3L4.37 7 10 10.94V8a5.54 5.54 0 0 1 1.9 10.48v2.12A7.5 7.5 0 0 0 10 6Z"/></svg>
        </media-seek-button>
        <media-seek-button class="mc-button" seconds="30">
            <svg class="mc-icon" viewBox="0 0 20 24" aria-hidden="true"><text class="mc-seek-label" x="8.9" y="19.87">30</text><path d="M10 6V3l5.61 4L10 10.94V8a5.54 5.54 0 0 0-1.9 10.48v2.12A7.5 7.5 0 0 1 10 6Z"/></svg>
        </media-seek-button>
        <media-mute-button class="mc-button">
            <svg class="mc-icon mc-volume-off" viewBox="0 0 24 24" aria-hidden="true"><path d="M16.5 12A4.5 4.5 0 0 0 14 8v2.18l2.45 2.45a4.22 4.22 0 0 0 .05-.63Zm2.5 0a6.84 6.84 0 0 1-.54 2.64L20 16.15A8.8 8.8 0 0 0 21 12a9 9 0 0 0-7-8.77v2.06A7 7 0 0 1 19 12ZM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25A6.92 6.92 0 0 1 14 18.7v2.06A9 9 0 0 0 17.69 19l2 2.05L21 19.73l-9-9L4.27 3ZM12 4 9.91 6.09 12 8.18V4Z"/></svg>
            <svg class="mc-icon mc-volume-low" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.47 4.47 0 0 0 2.5-4Z"/></svg>
            <svg class="mc-icon mc-volume-high" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9v6h4l5 5V4L7 9H3Zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.47 4.47 0 0 0 2.5-4ZM14 3.23v2.06a7 7 0 0 1 0 13.42v2.06a9 9 0 0 0 0-17.54Z"/></svg>
        </media-mute-button>
        <div class="mc-range mc-volume-range">
            <media-volume-slider class="mc-slider">
                <media-slider-track class="mc-track">
                    <media-slider-fill class="mc-fill"></media-slider-fill>
                </media-slider-track>
                <media-slider-thumb class="mc-thumb"></media-slider-thumb>
            </media-volume-slider>
        </div>
        <div class="mc-range mc-time-range">
            <media-time-slider class="mc-slider">
                <media-slider-track class="mc-track">
                    <media-slider-buffer class="mc-buffer"></media-slider-buffer>
                    <media-slider-fill class="mc-fill"></media-slider-fill>
                </media-slider-track>
                <media-slider-thumb class="mc-thumb"></media-slider-thumb>
            </media-time-slider>
        </div>
        <media-time-group class="mc-time">
            <media-time type="current"></media-time>
            <media-time-separator></media-time-separator>
            <media-time type="duration"></media-time>
        </media-time-group>
        <media-captions-button class="mc-button">
            <svg class="mc-icon mc-captions-off" viewBox="0 0 26 24" aria-hidden="true"><path d="M17.73 14.09a1.4 1.4 0 0 1-1 .37 1.579 1.579 0 0 1-1.27-.58A3 3 0 0 1 15 12a2.8 2.8 0 0 1 .5-1.85 1.63 1.63 0 0 1 1.29-.57 1.47 1.47 0 0 1 1.51 1.2l1.43-.34A2.89 2.89 0 0 0 19 9.07a3 3 0 0 0-2.14-.78 3.14 3.14 0 0 0-2.42 1 3.91 3.91 0 0 0-.93 2.78 3.74 3.74 0 0 0 .92 2.66 3.07 3.07 0 0 0 2.34 1 3.07 3.07 0 0 0 1.91-.57 3.17 3.17 0 0 0 1.07-1.74l-1.4-.45c-.083.43-.3.822-.62 1.12Zm-7.22 0a1.43 1.43 0 0 1-1 .37 1.58 1.58 0 0 1-1.27-.58A3 3 0 0 1 7.76 12a2.8 2.8 0 0 1 .5-1.85 1.63 1.63 0 0 1 1.29-.57 1.47 1.47 0 0 1 1.51 1.2l1.43-.34a2.81 2.81 0 0 0-.74-1.32 2.94 2.94 0 0 0-2.13-.78 3.18 3.18 0 0 0-2.43 1 4 4 0 0 0-.92 2.78 3.74 3.74 0 0 0 .92 2.66 3.07 3.07 0 0 0 2.34 1 3.07 3.07 0 0 0 1.91-.57 3.23 3.23 0 0 0 1.07-1.74l-1.4-.45a2.06 2.06 0 0 1-.6 1.07Zm12.32-8.41a2.59 2.59 0 0 0-2.3-2.51C18.72 3.05 15.86 3 13 3c-2.86 0-5.72.05-7.53.17a2.59 2.59 0 0 0-2.3 2.51c-.23 4.207-.23 8.423 0 12.63a2.57 2.57 0 0 0 2.3 2.5c1.81.13 4.67.19 7.53.19 2.86 0 5.72-.06 7.53-.19a2.57 2.57 0 0 0 2.3-2.5c.23-4.207.23-8.423 0-12.63Zm-1.49 12.53a1.11 1.11 0 0 1-.91 1.11c-1.67.11-4.45.18-7.43.18-2.98 0-5.76-.07-7.43-.18a1.11 1.11 0 0 1-.91-1.11c-.21-4.14-.21-8.29 0-12.43a1.11 1.11 0 0 1 .91-1.11C7.24 4.56 10 4.49 13 4.49s5.76.07 7.43.18a1.11 1.11 0 0 1 .91 1.11c.21 4.14.21 8.29 0 12.43Z"/></svg>
            <svg class="mc-icon mc-captions-on" viewBox="0 0 26 24" aria-hidden="true"><path d="M22.83 5.68a2.58 2.58 0 0 0-2.3-2.5c-3.62-.24-11.44-.24-15.06 0a2.58 2.58 0 0 0-2.3 2.5c-.23 4.21-.23 8.43 0 12.64a2.58 2.58 0 0 0 2.3 2.5c3.62.24 11.44.24 15.06 0a2.58 2.58 0 0 0 2.3-2.5c.23-4.21.23-8.43 0-12.64Zm-11.39 9.45a3.07 3.07 0 0 1-1.91.57 3.06 3.06 0 0 1-2.34-1 3.75 3.75 0 0 1-.92-2.67 3.92 3.92 0 0 1 .92-2.77 3.18 3.18 0 0 1 2.43-1 2.94 2.94 0 0 1 2.13.78c.364.359.62.813.74 1.31l-1.43.35a1.49 1.49 0 0 0-1.51-1.17 1.61 1.61 0 0 0-1.29.58 2.79 2.79 0 0 0-.5 1.89 3 3 0 0 0 .49 1.93 1.61 1.61 0 0 0 1.27.58 1.48 1.48 0 0 0 1-.37 2.1 2.1 0 0 0 .59-1.14l1.4.44a3.23 3.23 0 0 1-1.07 1.69Zm7.22 0a3.07 3.07 0 0 1-1.91.57 3.06 3.06 0 0 1-2.34-1 3.75 3.75 0 0 1-.92-2.67 3.88 3.88 0 0 1 .93-2.77 3.14 3.14 0 0 1 2.42-1 3 3 0 0 1 2.16.82 2.8 2.8 0 0 1 .73 1.31l-1.43.35a1.49 1.49 0 0 0-1.51-1.21 1.61 1.61 0 0 0-1.29.58A2.79 2.79 0 0 0 15 12a3 3 0 0 0 .49 1.93 1.61 1.61 0 0 0 1.27.58 1.44 1.44 0 0 0 1-.37 2.1 2.1 0 0 0 .6-1.15l1.4.44a3.17 3.17 0 0 1-1.1 1.7Z"/></svg>
        </media-captions-button>
        <media-pip-button class="mc-button">
            <svg class="mc-icon" viewBox="0 0 28 24" aria-hidden="true"><path d="M24 3H4a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h20a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1Zm-1 16H5V5h18v14Zm-3-8h-7v5h7v-5Z"/></svg>
        </media-pip-button>
        <media-fullscreen-button class="mc-button">
            <svg class="mc-icon mc-fullscreen-enter" viewBox="0 0 26 24" aria-hidden="true"><path d="M16 3v2.5h3.5V9H22V3h-6ZM4 9h2.5V5.5H10V3H4v6Zm15.5 9.5H16V21h6v-6h-2.5v3.5ZM6.5 15H4v6h6v-2.5H6.5V15Z"/></svg>
            <svg class="mc-icon mc-fullscreen-exit" viewBox="0 0 26 24" aria-hidden="true"><path d="M18.5 6.5V3H16v6h6V6.5h-3.5ZM16 21h2.5v-3.5H22V15h-6v6ZM4 17.5h3.5V21H10v-6H4v2.5Zm3.5-11H4V9h6V3H7.5v3.5Z"/></svg>
        </media-fullscreen-button>
    </div>
</media-controls>
