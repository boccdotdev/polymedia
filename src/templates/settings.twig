{% import '_includes/forms.twig' as forms %}

{% set allowAdminChanges = craft.app.config.general.allowAdminChanges %}

<h2>{{ 'Volumes'|t('polymedia') }}</h2>

{{ forms.selectField({
    label: 'Default Volume'|t('polymedia'),
    instructions: 'Where new media URL manifest files (.pmedia) are saved.'|t('polymedia'),
    id: 'defaultVolumeUid',
    name: 'defaultVolumeUid',
    value: settings.defaultVolumeUid,
    options: volumeOptions,
    errors: settings.getErrors('defaultVolumeUid'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.selectField({
    label: 'Sidecar Volume'|t('polymedia'),
    instructions: 'A dedicated volume for poster images and WebVTT files managed by Polymedia. The plugin hides this volume from asset indexes and pickers.'|t('polymedia'),
    id: 'sidecarVolumeUid',
    name: 'sidecarVolumeUid',
    value: settings.sidecarVolumeUid,
    options: volumeOptions,
    errors: settings.getErrors('sidecarVolumeUid'),
    disabled: not allowAdminChanges,
}) }}

{% if not settings.sidecarVolumeUid %}
    <div class="readable">
        <blockquote class="note warning">
            <p>
                {{ 'No sidecar volume is selected. Polymedia will not create local poster or WebVTT assets until one is configured.'|t('polymedia') }}
            </p>
            <p>
                {{ 'Create the default public local volume with `php craft polymedia/setup/sidecar-volume`, or create a volume backed by S3, Google Cloud, or another filesystem and select it here.'|t('polymedia') }}
            </p>
        </blockquote>
    </div>
{% endif %}

<hr>

<h2>{{ 'Player'|t('polymedia') }}</h2>

{# An autosuggest, not a select: a select can't show an env var that's unset in this environment, and saving would overwrite it. #}
{{ forms.autosuggestField({
    label: 'Player Engine'|t('polymedia'),
    instructions: "`media-chrome` or `videojs`. Media Chrome and Video.js can't load on the same page, so this applies to the whole site. Use an environment variable, such as `$POLYMEDIA_PLAYER_ENGINE`, to try Video.js in one environment first."|t('polymedia'),
    tip: 'Video.js needs Chrome 111, Firefox 113, Safari 16.2 or newer.'|t('polymedia'),
    id: 'playerEngine',
    name: 'playerEngine',
    value: settings.playerEngine,
    suggestions: [{
        label: 'Engines'|t('polymedia'),
        data: [
            { name: 'media-chrome', hint: 'Media Chrome'|t('polymedia') },
            { name: 'videojs', hint: 'Video.js'|t('polymedia') },
        ],
    }],
    suggestEnvVars: true,
    errors: settings.getErrors('playerEngine'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.selectField({
    label: 'Video.js Skin'|t('polymedia'),
    instructions: 'The packaged skin Video.js players use. Templates can pick another per player with the `skin` option.'|t('polymedia'),
    id: 'videojsSkin',
    name: 'videojsSkin',
    value: settings.videojsSkin,
    options: [
        { label: 'Default'|t('polymedia'), value: 'default' },
        { label: 'Neutral'|t('polymedia'), value: 'neutral' },
        { label: 'Compat'|t('polymedia'), value: 'compat' },
    ],
    errors: settings.getErrors('videojsSkin'),
    disabled: not allowAdminChanges,
}) }}

<hr>

<h2>{{ 'Scripts'|t('polymedia') }}</h2>

{{ forms.selectField({
    label: 'Script Loader Mode'|t('polymedia'),
    instructions: 'How front-end player scripts are loaded.'|t('polymedia'),
    id: 'scriptLoaderMode',
    name: 'scriptLoaderMode',
    value: settings.scriptLoaderMode,
    options: [
        { label: 'CDN (default)'|t('polymedia'), value: 'cdn' },
        { label: 'Self-hosted'|t('polymedia'), value: 'self-host' },
        { label: 'None (manual)'|t('polymedia'), value: 'none' },
    ],
    errors: settings.getErrors('scriptLoaderMode'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.autosuggestField({
    label: 'CDN Host'|t('polymedia'),
    instructions: 'CDN hostname for script tags. Default is `cdn.jsdelivr.net`.'|t('polymedia'),
    id: 'cdnHost',
    name: 'cdnHost',
    value: settings.cdnHost,
    suggestEnvVars: true,
    errors: settings.getErrors('cdnHost'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.autosuggestField({
    label: 'Self-Host Base URL'|t('polymedia'),
    instructions: 'Base URL for self-hosted scripts, e.g. `/dist/polymedia/`.'|t('polymedia'),
    id: 'selfHostBaseUrl',
    name: 'selfHostBaseUrl',
    value: settings.selfHostBaseUrl,
    suggestEnvVars: true,
    suggestAliases: true,
    errors: settings.getErrors('selfHostBaseUrl'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.textField({
    label: 'Media Chrome Version'|t('polymedia'),
    instructions: 'Major version of Media Chrome for the `scripts()` Twig helper.'|t('polymedia'),
    id: 'mediaChromeVersion',
    name: 'mediaChromeVersion',
    value: settings.mediaChromeVersion,
    size: 4,
    errors: settings.getErrors('mediaChromeVersion'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.textField({
    label: 'Video.js Version'|t('polymedia'),
    instructions: 'Exact Video.js version for the `scripts()` Twig helper when the player engine is Video.js, e.g. `10.1.0`.'|t('polymedia'),
    id: 'videojsVersion',
    name: 'videojsVersion',
    value: settings.videojsVersion,
    size: 10,
    errors: settings.getErrors('videojsVersion'),
    disabled: not allowAdminChanges,
}) }}

{{ forms.checkboxGroupField({
    label: 'Default Providers'|t('polymedia'),
    instructions: 'Providers included when `scripts()` is called without arguments.'|t('polymedia'),
    id: 'defaultProviders',
    name: 'defaultProviders',
    values: settings.defaultProviders,
    options: [
        { label: 'HLS', value: 'hls' },
        { label: 'DASH', value: 'dash' },
        { label: 'Shaka', value: 'shaka' },
        { label: 'Mux', value: 'mux' },
        { label: 'YouTube', value: 'youtube' },
        { label: 'Vimeo', value: 'vimeo' },
        { label: 'Spotify', value: 'spotify' },
        { label: 'TikTok', value: 'tiktok' },
        { label: 'Wistia', value: 'wistia' },
        { label: 'JW Player', value: 'jwplayer' },
        { label: 'Twitch', value: 'twitch' },
        { label: 'Cloudflare', value: 'cloudflare' },
        { label: 'PeerTube', value: 'peertube' },
        { label: 'Video.js (v8 embed)'|t('polymedia'), value: 'videojs' },
    ],
    disabled: not allowAdminChanges,
}) }}

<hr>

<h2>{{ 'Behaviour'|t('polymedia') }}</h2>

{{ forms.lightswitchField({
    label: 'Validate VTT on Upload'|t('polymedia'),
    instructions: 'Check for a valid `WEBVTT` header when attaching caption files.'|t('polymedia'),
    id: 'validateVttOnUpload',
    name: 'validateVttOnUpload',
    on: settings.validateVttOnUpload,
    disabled: not allowAdminChanges,
}) }}

{{ forms.lightswitchField({
    label: 'Auto-Fetch Poster'|t('polymedia'),
    instructions: 'When adding a media URL without a custom poster, download a provider thumbnail (Mux first frame, YouTube/Vimeo stills, etc.) into the sidecar volume. Mux library imports always fetch a poster when none is set.'|t('polymedia'),
    id: 'autoFetchPoster',
    name: 'autoFetchPoster',
    on: settings.autoFetchPoster,
    disabled: not allowAdminChanges,
}) }}

{# Dead settings (kept on Settings model for project config BC; UI removed 1.2.2):
   requireCaptionsForVideo, defaultCaptionLanguageFromSite, restrictAssetKinds #}

<hr>

<h2>{{ 'Security'|t('polymedia') }}</h2>

{{ forms.lightswitchField({
    label: 'Signed URL Warning'|t('polymedia'),
    instructions: 'Show a confirmation prompt when saving a media URL with signed tokens into a publicly accessible volume.'|t('polymedia'),
    id: 'warnOnSignedUrlInPublicVolume',
    name: 'warnOnSignedUrlInPublicVolume',
    on: settings.warnOnSignedUrlInPublicVolume,
    disabled: not allowAdminChanges,
}) }}

<hr>

<h2>{{ 'Video Hosting'|t('polymedia') }}</h2>

{% if not isPro %}
    <div class="readable">
        <blockquote class="note tip">
            <p>
                {{ 'Connected video libraries and direct uploads require Polymedia Pro. Pasting a Mux or other media URL still works on Lite.'|t('polymedia') }}
            </p>
            <p>
                <a href="https://plugins.craftcms.com/polymedia" target="_blank" rel="noopener">
                    {{ 'Upgrade to Pro in the Plugin Store'|t('polymedia') }}
                </a>
            </p>
        </blockquote>
    </div>
{% else %}
    {{ forms.selectField({
        label: 'Video Hosting Provider'|t('polymedia'),
        instructions: 'Handles new library imports and uploads. Authors see one video library. Existing assets keep their own provider, so changing this doesn’t move any videos.'|t('polymedia'),
        id: 'videoProvider',
        name: 'videoProvider',
        value: settings.videoProvider,
        options: [
            { label: 'Mux', value: 'mux' },
            { label: 'Bunny Stream', value: 'bunny' },
        ],
        errors: settings.getErrors('videoProvider'),
        disabled: not allowAdminChanges,
    }) }}

    <p class="light">{{ 'Keep the credentials for a previous provider while its existing assets still need syncing or remote deletion.'|t('polymedia') }}</p>

    <details{% if settings.videoProvider == 'mux' %} open{% endif %}>
        <summary><strong>{{ 'Mux Connection'|t('polymedia') }}</strong></summary>

        {% if not muxConfigured %}
            <div class="readable">
                <blockquote class="note">
                    <p>
                        {{ 'Add both a Token ID and Secret to connect Mux.'|t('polymedia') }}
                    </p>
                </blockquote>
            </div>
        {% endif %}

        {{ forms.autosuggestField({
            label: 'Mux Token ID'|t('polymedia'),
            instructions: 'API access token ID from the Mux dashboard. Select an environment variable such as `$MUX_TOKEN_ID`; literal values cannot be saved to project config.'|t('polymedia'),
            id: 'muxTokenId',
            name: 'muxTokenId',
            value: settings.muxTokenId,
            suggestEnvVars: true,
            errors: settings.getErrors('muxTokenId'),
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.autosuggestField({
            label: 'Mux Token Secret'|t('polymedia'),
            instructions: 'API access token secret. Select an environment variable such as `$MUX_TOKEN_SECRET`; literal values cannot be saved to project config.'|t('polymedia'),
            id: 'muxTokenSecret',
            name: 'muxTokenSecret',
            value: settings.muxTokenSecret,
            suggestEnvVars: true,
            errors: settings.getErrors('muxTokenSecret'),
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.lightswitchField({
            label: 'Delete Mux asset when Craft asset is deleted'|t('polymedia'),
            instructions: 'When enabled, hard-deleting a Mux `.pmedia` asset also deletes the video from your Mux account. Soft-delete / trash is never sent to Mux. Default off.'|t('polymedia'),
            id: 'deleteMuxAssetOnDelete',
            name: 'deleteMuxAssetOnDelete',
            on: settings.deleteMuxAssetOnDelete,
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.autosuggestField({
            label: 'Mux Webhook Signing Secret'|t('polymedia'),
            instructions: 'Optional. When set, Mux webhooks keep item status and posters current without polling; leave empty to disable the webhook endpoint. Select an environment variable such as `$MUX_WEBHOOK_SECRET`; literal values cannot be saved to project config.'|t('polymedia'),
            id: 'muxWebhookSecret',
            name: 'muxWebhookSecret',
            value: settings.muxWebhookSecret,
            suggestEnvVars: true,
            errors: settings.getErrors('muxWebhookSecret'),
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.copytextField({
            label: 'Webhook URL'|t('polymedia'),
            instructions: 'Add this URL as a webhook in the Mux dashboard (Settings → Webhooks) for the environment your tokens belong to.'|t('polymedia'),
            id: 'muxWebhookUrl',
            class: 'code',
            value: muxWebhookUrl,
        }) }}
    </details>

    <details{% if settings.videoProvider == 'bunny' %} open{% endif %}>
        <summary><strong>{{ 'Bunny Stream Connection'|t('polymedia') }}</strong></summary>

        {% if not bunnyConfigured %}
            <div class="readable">
                <blockquote class="note">
                    <p>
                        {{ 'Add a library ID, API key and CDN hostname to connect Bunny Stream.'|t('polymedia') }}
                    </p>
                </blockquote>
            </div>
        {% endif %}

        {{ forms.autosuggestField({
            label: 'Bunny Library ID'|t('polymedia'),
            instructions: 'The Stream video library ID. Supports an environment variable such as `$BUNNY_LIBRARY_ID`.'|t('polymedia'),
            id: 'bunnyLibraryId',
            name: 'bunnyLibraryId',
            value: settings.bunnyLibraryId,
            suggestEnvVars: true,
            errors: settings.getErrors('bunnyLibraryId'),
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.autosuggestField({
            label: 'Bunny Library API Key'|t('polymedia'),
            instructions: 'Select an environment variable such as `$BUNNY_API_KEY` that holds this library’s API key, not your account API key. Literal values cannot be saved to project config, and the key is never sent to the browser.'|t('polymedia'),
            id: 'bunnyApiKey',
            name: 'bunnyApiKey',
            value: settings.bunnyApiKey,
            suggestEnvVars: true,
            errors: settings.getErrors('bunnyApiKey'),
            disabled: not allowAdminChanges,
        }) }}

        {{ forms.autosuggestField({
            label: 'Bunny CDN Hostname'|t('polymedia'),
            instructions: 'The library’s delivery hostname, such as `vz-example.b-cdn.net`, without `https://` or a path. Custom domains, token authentication and DRM are not supported. Supports an environment variable such as `$BUNNY_CDN_HOSTNAME`.'|t('polymedia'),
            id: 'bunnyCdnHostname',
            name: 'bunnyCdnHostname',
            value: settings.bunnyCdnHostname,
            suggestEnvVars: true,
            errors: settings.getErrors('bunnyCdnHostname'),
            disabled: not allowAdminChanges,
        }) }}
    </details>
{% endif %}

<hr>

<h2>{{ 'Field Defaults'|t('polymedia') }}</h2>

{{ forms.checkboxGroupField({
    label: 'Default Allowed Providers'|t('polymedia'),
    instructions: 'Default provider restriction for new Polymedia fields. Empty means all providers allowed.'|t('polymedia'),
    id: 'defaultFieldAllowedProviders',
    name: 'defaultFieldAllowedProviders',
    values: settings.defaultFieldAllowedProviders,
    options: [
        { label: 'HLS', value: 'hls' },
        { label: 'DASH', value: 'dash' },
        { label: 'Shaka', value: 'shaka' },
        { label: 'Mux', value: 'mux' },
        { label: 'YouTube', value: 'youtube' },
        { label: 'Vimeo', value: 'vimeo' },
        { label: 'Spotify', value: 'spotify' },
        { label: 'TikTok', value: 'tiktok' },
        { label: 'Wistia', value: 'wistia' },
        { label: 'JW Player', value: 'jwplayer' },
        { label: 'Twitch', value: 'twitch' },
        { label: 'Cloudflare', value: 'cloudflare' },
        { label: 'PeerTube', value: 'peertube' },
        { label: 'Video.js', value: 'videojs' },
        { label: 'MP4/WebM/MOV', value: 'mp4' },
        { label: 'Audio', value: 'audio' },
    ],
    disabled: not allowAdminChanges,
}) }}

